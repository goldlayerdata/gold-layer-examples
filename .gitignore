# Local generator binaries + download caches (hundreds of MB) - see each dataset's README
.engine/

# Generated data: rebuild with datasets/<name>/generate/. Only the manifest is tracked.
datasets/*/data/latest/*
!datasets/*/data/latest/_manifest.json
datasets/*/data/runs/
datasets/*/data/_staging/

# Power BI Desktop local state
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Examples ship as one PBIX each (decided 2026-11-13). The PBIP working copy stays local.
# examples/default/ was committed as PBIP before this; tracked files are unaffected.
examples/*/*.pbip
examples/*/*.Report/
examples/*/*.SemanticModel/
*.pbix
!examples/*/*.pbix

# Editor / OS / tooling
.vscode/
.DS_Store
Thumbs.db
~$*
*.log
__pycache__/
