  "background": "#10204A",
  "backgroundLight": "#0A1328",
  "backgroundNeutral": "#1B3466",
  "backgroundDark": "#14275A",
  "tableAccent": "#F2C811",
  "hyperlink": "#FFE785",
  "shapeStroke": "#1B3466",
  "accent": "#F2C811",
  "textClasses": {
    "callout": {
      "color": "#E8ECF5",
      "fontFace": "Segoe UI Bold",
      "fontSize": 30
    },
    "largeTitle": {
      "color": "#E8ECF5",
      "fontFace": "Segoe UI Bold",
      "fontSize": 22
