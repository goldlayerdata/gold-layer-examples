{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.152.json",
  "name": "Gold Layer Dark v1.0",
  "dataColors": [
    "#F2C811",
    "#5B8BF0",
    "#218B75",
    "#D590C5",
    "#D78100",
    "#84BFE9",
    "#627299",
    "#EC927C"
  ],
  "good": "#218B75",
  "bad": "#EC927C",
  "neutral": "#A3AEC8",
  "maximum": "#F2C811",
  "center": "#1B3466",
  "minimum": "#5B8BF0",
  "null": "#7F8BA8",
  "foreground": "#E8ECF5",
