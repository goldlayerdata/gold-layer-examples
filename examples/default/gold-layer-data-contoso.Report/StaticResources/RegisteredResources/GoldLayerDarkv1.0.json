    "boldLabel": {
      "color": "#E8ECF5",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10
    },
    "dataTitle": {
      "color": "#F2C811",
      "fontFace": "Consolas",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#10204A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1B3466"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "background": {
              "solid": {
                "color": "#10204A"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 12,
            "right": 12
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#0A1328"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E8ECF5"
              }
