        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#10204A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#14275A"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColor": {
              "solid": {
                "color": "#14275A"
              }
            }
          }
        ],
        "columnTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColor": {
              "solid": {
                "color": "#14275A"
              }
            }
          }
        ],
        "rowTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColor": {
              "solid": {
                "color": "#14275A"
              }
            }
          }
        ]
      }
    },
    "shape": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
