            "backColor": {
              "solid": {
                "color": "#14275A"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColor": {
              "solid": {
                "color": "#10204A"
              }
            }
          }
