            "backColor": {
              "solid": {
                "color": "#14275A"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#10204A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E8ECF5"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#14275A"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF5"
              }
