                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Orders after the as-of day are left out. Deliveries after it are blank (not delivered yet). Exchange rates stop at it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A3AEC8"
                    }
