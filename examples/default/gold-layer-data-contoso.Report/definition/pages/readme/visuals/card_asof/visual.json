                      "fontSize": "11pt",
                      "color": "#E8ECF5"
                    }
                  },
                  {
                    "value": "is today by default, so every refresh shows the data up to today. Type a date (yyyy-MM-dd) to freeze it, e.g. the date in a post, to get the same numbers as its screenshots.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
