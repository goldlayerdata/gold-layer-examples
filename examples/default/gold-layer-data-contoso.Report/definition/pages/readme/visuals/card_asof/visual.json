                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The date table runs to 31 December of the as-of year, so time intelligence sees whole years. DateWithSales is TRUE up to the as-of day: filter on it so this year is not compared with a full last year.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
