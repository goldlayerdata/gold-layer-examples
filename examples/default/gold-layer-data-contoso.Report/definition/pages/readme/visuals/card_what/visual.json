                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Two ways to read sales. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#E8ECF5"
                    }
                  },
                  {
                    "value": "sales is flat, one row per order line. orders + orderrows hold the same lines as header and detail. Use one or the other in a visual, not both.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A3AEC8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#A3AEC8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Dimensions. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#E8ECF5"
                    }
                  },
                  {
                    "value": "customer, product and store, plus date, marked as the date table.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A3AEC8"
                    }
                  }
                ]
