                      "fontSize": "5pt",
                      "color": "#A3AEC8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Currency. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#E8ECF5"
                    }
                  },
                  {
                    "value": "Prices are in USD. CurrencyCode and ExchangeRate on each order give the customer's local currency; currencyexchange holds the daily rates for conversion measures.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A3AEC8"
                    }
